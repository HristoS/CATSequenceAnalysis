<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.7.0" />
    <PackageReference Include="NUnit" Version="4.6.1" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.2.0" />
    <PackageReference Include="NUnit.Analyzers" Version="4.14.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SequenceAnalise\SequenceAnalise.csproj" />
    <ProjectReference Include="..\SequencePlatform.Core\SequencePlatform.Core.csproj" />
    <!-- Only for the explicit end-to-end ingest test (IngestTests). -->
    <ProjectReference Include="..\SequencePlatform.Ingest\SequencePlatform.Ingest.csproj" />
  </ItemGroup>

  <!-- The bundled corpus's verified taxonomy, linked rather than copied so the analysis tests and BundledCorpus share one list. -->
  <ItemGroup>
    <Compile Include="..\SequenceAnaliseTests\GenomeCatalog.cs" Link="Linked\GenomeCatalog.cs" />
    <Compile Include="..\SequenceAnaliseTests\GenomeTaxonomy.cs" Link="Linked\GenomeTaxonomy.cs" />
    <Compile Include="..\SequenceAnaliseTests\ViralTaxonomy.cs" Link="Linked\ViralTaxonomy.cs" />
  </ItemGroup>

  <!-- Same git-ignored server connection as the Ingest; the tests only use it to create and drop their own database. -->
  <ItemGroup>
    <None Include="..\SequencePlatform.Ingest\appsettings.json" Link="appsettings.json"
          Condition="Exists('..\SequencePlatform.Ingest\appsettings.json')" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
